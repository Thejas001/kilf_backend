# --- Server ---
NODE_ENV=development
PORT=4000
FRONTEND_URL=http://localhost:5173

# --- Database ---
# Local dev (matches docker-compose.yml):
DATABASE_URL=postgresql://kilf:kilf@localhost:5432/kilf?schema=public

# --- Auth ---
JWT_SECRET=change-this-to-a-long-random-string-in-production
JWT_EXPIRES_IN=15m
JWT_REFRESH_SECRET=change-this-to-a-different-long-random-string
JWT_REFRESH_EXPIRES_IN=7d

# --- Payments (mock provider by default) ---
PAYMENT_PROVIDER=mock
PAYMENT_SECRET=dev-mock-payment-secret

# --- Razorpay (only required when PAYMENT_PROVIDER=razorpay) ---
# Get these from Razorpay Dashboard > Settings > API Keys, and
# Settings > Webhooks (create a webhook pointed at /api/webhooks/razorpay,
# subscribed to payment.captured, payment.failed, refund.processed, and set
# its secret below - it must match RAZORPAY_WEBHOOK_SECRET exactly).
RAZORPAY_KEY_ID=
RAZORPAY_KEY_SECRET=
RAZORPAY_WEBHOOK_SECRET=

# --- Booking ---
BOOKING_HOLD_MINUTES=15

# --- Rate limiting ---
RATE_LIMIT_WINDOW_MS=900000
RATE_LIMIT_MAX=300

# --- File uploads ---
UPLOAD_DIR=uploads
MAX_UPLOAD_MB=5

# --- Logging ---
LOG_LEVEL=info
