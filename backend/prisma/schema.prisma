generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "postgresql"
  url      = env("DATABASE_URL")
}

// ---------------------------------------------------------------------------
// Enums
// ---------------------------------------------------------------------------

enum AdminRole {
  SUPER_ADMIN
  ADMIN
}

enum FestivalStatus {
  DRAFT
  PUBLISHED
  CANCELLED
  COMPLETED
}

enum TicketType {
  GENERAL
  VIP
  STUDENT
  EARLY_BIRD
  DAY_PASS
  FULL_FESTIVAL
}

enum TicketSaleStatus {
  ACTIVE
  INACTIVE
}

enum BookingStatus {
  PENDING_PAYMENT
  CONFIRMED
  CANCELLED
  REFUNDED
  EXPIRED
}

enum PaymentStatus {
  PENDING
  SUCCESS
  FAILED
  REFUNDED
}

enum PaymentProviderType {
  MOCK
  STRIPE
  RAZORPAY
}

enum TicketInstanceStatus {
  VALID
  USED
  CANCELLED
}

enum SponsorshipLevel {
  TITLE
  PLATINUM
  GOLD
  SILVER
  BRONZE
  PARTNER
}

enum SponsorStatus {
  ACTIVE
  INACTIVE
}

// ---------------------------------------------------------------------------
// Models
// ---------------------------------------------------------------------------

model Admin {
  id                    String    @id @default(uuid())
  name                  String
  email                 String    @unique
  passwordHash          String    @map("password_hash")
  role                  AdminRole @default(ADMIN)
  isActive              Boolean   @default(true) @map("is_active")
  lastLoginAt           DateTime? @map("last_login_at")
  passwordResetToken    String?   @map("password_reset_token")
  passwordResetExpires  DateTime? @map("password_reset_expires")
  refreshTokenHash      String?   @map("refresh_token_hash")
  createdAt             DateTime  @default(now()) @map("created_at")
  updatedAt             DateTime  @updatedAt @map("updated_at")

  auditLogs             AuditLog[]
  checkedInInstances    TicketInstance[] @relation("CheckedInBy")

  @@index([email])
  @@map("admins")
}

model Festival {
  id                 String         @id @default(uuid())
  name               String
  description        String?
  location           String?
  venue              String?
  startDate          DateTime       @map("start_date")
  endDate            DateTime       @map("end_date")
  registrationStart  DateTime?      @map("registration_start")
  registrationEnd    DateTime?      @map("registration_end")
  bannerImage        String?        @map("banner_image")
  status             FestivalStatus @default(DRAFT)
  createdAt          DateTime       @default(now()) @map("created_at")
  updatedAt          DateTime       @updatedAt @map("updated_at")

  tickets            Ticket[]
  bookings           Booking[]
  sponsors           Sponsor[]

  @@index([status])
  @@map("festivals")
}

model Ticket {
  id                 String           @id @default(uuid())
  festivalId         String           @map("festival_id")
  name               String
  description        String?
  ticketType         TicketType       @default(GENERAL) @map("ticket_type")
  price              Decimal          @db.Decimal(12, 2)
  currency           String           @default("INR")
  totalQuantity      Int              @map("total_quantity")
  availableQuantity  Int              @map("available_quantity")
  salesStart         DateTime         @map("sales_start")
  salesEnd           DateTime         @map("sales_end")
  status             TicketSaleStatus @default(ACTIVE)
  createdAt          DateTime         @default(now()) @map("created_at")
  updatedAt          DateTime         @updatedAt @map("updated_at")

  festival           Festival         @relation(fields: [festivalId], references: [id], onDelete: Cascade)
  bookingItems       BookingItem[]
  ticketInstances    TicketInstance[]

  @@index([festivalId])
  @@index([status])
  @@map("tickets")
}

model Customer {
  id         String    @id @default(uuid())
  name       String
  email      String
  phone      String
  createdAt  DateTime  @default(now()) @map("created_at")
  updatedAt  DateTime  @updatedAt @map("updated_at")

  bookings   Booking[]

  @@unique([email])
  @@map("customers")
}

model Booking {
  id             String        @id @default(uuid())
  bookingNumber  String        @unique @map("booking_number")
  festivalId     String        @map("festival_id")
  customerId     String        @map("customer_id")
  status         BookingStatus @default(PENDING_PAYMENT)
  quantity       Int
  totalAmount    Decimal       @db.Decimal(12, 2) @map("total_amount")
  currency       String        @default("INR")
  expiresAt      DateTime?     @map("expires_at")
  cancelledAt    DateTime?     @map("cancelled_at")
  cancelReason   String?       @map("cancel_reason")
  createdAt      DateTime      @default(now()) @map("created_at")
  updatedAt      DateTime      @updatedAt @map("updated_at")

  festival       Festival        @relation(fields: [festivalId], references: [id])
  customer       Customer        @relation(fields: [customerId], references: [id])
  bookingItems   BookingItem[]
  payments       Payment[]
  ticketInstances TicketInstance[]

  @@index([festivalId])
  @@index([customerId])
  @@index([status])
  @@index([createdAt])
  @@map("bookings")
}

model BookingItem {
  id          String   @id @default(uuid())
  bookingId   String   @map("booking_id")
  ticketId    String   @map("ticket_id")
  quantity    Int
  unitPrice   Decimal  @db.Decimal(12, 2) @map("unit_price")
  subtotal    Decimal  @db.Decimal(12, 2)
  createdAt   DateTime @default(now()) @map("created_at")

  booking     Booking  @relation(fields: [bookingId], references: [id], onDelete: Cascade)
  ticket      Ticket   @relation(fields: [ticketId], references: [id])
  ticketInstances TicketInstance[]

  @@index([bookingId])
  @@index([ticketId])
  @@map("booking_items")
}

model Payment {
  id                String              @id @default(uuid())
  bookingId         String              @map("booking_id")
  provider          PaymentProviderType @default(MOCK)
  providerPaymentId String?             @map("provider_payment_id")
  amount            Decimal             @db.Decimal(12, 2)
  currency          String              @default("INR")
  status            PaymentStatus       @default(PENDING)
  method            String?
  refundedAmount    Decimal             @default(0) @db.Decimal(12, 2) @map("refunded_amount")
  failureReason     String?             @map("failure_reason")
  rawResponse       Json?               @map("raw_response")
  createdAt         DateTime            @default(now()) @map("created_at")
  updatedAt         DateTime            @updatedAt @map("updated_at")

  booking           Booking             @relation(fields: [bookingId], references: [id], onDelete: Cascade)

  @@index([bookingId])
  @@index([status])
  @@map("payments")
}

model TicketInstance {
  id             String               @id @default(uuid())
  bookingId      String               @map("booking_id")
  bookingItemId  String               @map("booking_item_id")
  ticketId       String               @map("ticket_id")
  ticketNumber   String               @unique @map("ticket_number")
  qrCode         String               @map("qr_code")
  status         TicketInstanceStatus @default(VALID)
  checkedInAt    DateTime?            @map("checked_in_at")
  checkedInById  String?              @map("checked_in_by_id")
  createdAt      DateTime             @default(now()) @map("created_at")
  updatedAt      DateTime             @updatedAt @map("updated_at")

  booking        Booking              @relation(fields: [bookingId], references: [id], onDelete: Cascade)
  bookingItem    BookingItem          @relation(fields: [bookingItemId], references: [id], onDelete: Cascade)
  ticket         Ticket               @relation(fields: [ticketId], references: [id])
  checkedInBy    Admin?               @relation("CheckedInBy", fields: [checkedInById], references: [id])

  @@index([bookingId])
  @@index([ticketNumber])
  @@map("ticket_instances")
}

model Sponsor {
  id                 String           @id @default(uuid())
  festivalId         String?          @map("festival_id")
  name               String
  description        String?
  logoUrl            String?          @map("logo_url")
  websiteUrl         String?          @map("website_url")
  contactName        String?          @map("contact_name")
  contactEmail       String?          @map("contact_email")
  contactPhone       String?          @map("contact_phone")
  sponsorshipLevel   SponsorshipLevel @default(PARTNER) @map("sponsorship_level")
  amount             Decimal?         @db.Decimal(12, 2)
  status             SponsorStatus    @default(ACTIVE)
  displayOrder       Int              @default(0) @map("display_order")
  createdAt          DateTime         @default(now()) @map("created_at")
  updatedAt          DateTime         @updatedAt @map("updated_at")

  festival           Festival?        @relation(fields: [festivalId], references: [id], onDelete: SetNull)

  @@index([status])
  @@index([displayOrder])
  @@index([festivalId])
  @@map("sponsors")
}

model AuditLog {
  id          String   @id @default(uuid())
  adminId     String?  @map("admin_id")
  action      String
  entityType  String   @map("entity_type")
  entityId    String?  @map("entity_id")
  oldValue    Json?    @map("old_value")
  newValue    Json?    @map("new_value")
  ipAddress   String?  @map("ip_address")
  createdAt   DateTime @default(now()) @map("created_at")

  admin       Admin?   @relation(fields: [adminId], references: [id], onDelete: SetNull)

  @@index([adminId])
  @@index([entityType, entityId])
  @@index([createdAt])
  @@map("audit_logs")
}
