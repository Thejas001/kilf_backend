generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "postgresql"
  url      = env("DATABASE_URL")
}

// ---------------------------------------------------------------------------
// Enums
// ---------------------------------------------------------------------------

enum AdminRole {
  SUPER_ADMIN
  ADMIN
}

enum FestivalStatus {
  DRAFT
  PUBLISHED
  CANCELLED
  COMPLETED
}

enum TicketType {
  GENERAL
  VIP
  STUDENT
  EARLY_BIRD
  DAY_PASS
  FULL_FESTIVAL
  YOUNG_READER
  ELITE
  KHASAK_SHOW
  NEW_YEAR_EVE
}

enum ShowSessionStatus {
  ACTIVE
  INACTIVE
}

enum TicketSaleStatus {
  ACTIVE
  INACTIVE
}

enum BookingStatus {
  PENDING_PAYMENT
  CONFIRMED
  CANCELLED
  REFUNDED
  EXPIRED
  /// Money was captured but the booking could not be confirmed (late payment with
  /// no inventory left, or an amount mismatch). Inventory is NOT held. Admin must refund.
  PAYMENT_REVIEW
}

enum PaymentStatus {
  PENDING
  SUCCESS
  FAILED
  REFUNDED
}

enum PaymentProviderType {
  MOCK
  STRIPE
  RAZORPAY
}

enum TicketInstanceStatus {
  VALID
  USED
  CANCELLED
}

enum SponsorshipLevel {
  TITLE
  PLATINUM
  GOLD
  SILVER
  BRONZE
  PARTNER
}

enum SponsorStatus {
  ACTIVE
  INACTIVE
}

// ---------------------------------------------------------------------------
// Models
// ---------------------------------------------------------------------------

model Admin {
  id                    String    @id @default(uuid())
  name                  String
  email                 String    @unique
  passwordHash          String    @map("password_hash")
  role                  AdminRole @default(ADMIN)
  isActive              Boolean   @default(true) @map("is_active")
  lastLoginAt           DateTime? @map("last_login_at")
  passwordResetToken    String?   @map("password_reset_token")
  passwordResetExpires  DateTime? @map("password_reset_expires")
  refreshTokenHash      String?   @map("refresh_token_hash")
  createdAt             DateTime  @default(now()) @map("created_at")
  updatedAt             DateTime  @updatedAt @map("updated_at")

  auditLogs             AuditLog[]
  checkedInInstances    TicketInstance[] @relation("CheckedInBy")

  @@index([email])
  @@map("admins")
}

model Guest {
  id                    String    @id @default(uuid())
  name                  String
  email                 String    @unique
  passwordHash          String    @map("password_hash")
  isActive              Boolean   @default(true) @map("is_active")
  lastLoginAt           DateTime? @map("last_login_at")
  passwordResetToken    String?   @map("password_reset_token")
  passwordResetExpires  DateTime? @map("password_reset_expires")
  refreshTokenHash      String?   @map("refresh_token_hash")
  createdAt             DateTime  @default(now()) @map("created_at")
  updatedAt             DateTime  @updatedAt @map("updated_at")

  @@map("guests")
}

model Festival {
  id                 String         @id @default(uuid())
  name               String
  description        String?
  location           String?
  venue              String?
  startDate          DateTime       @map("start_date")
  endDate            DateTime       @map("end_date")
  registrationStart  DateTime?      @map("registration_start")
  registrationEnd    DateTime?      @map("registration_end")
  bannerImage        String?        @map("banner_image")
  status             FestivalStatus @default(DRAFT)
  createdAt          DateTime       @default(now()) @map("created_at")
  updatedAt          DateTime       @updatedAt @map("updated_at")

  tickets            Ticket[]
  bookings           Booking[]
  sponsors           Sponsor[]
  showSessions       ShowSession[]

  @@index([status])
  @@map("festivals")
}

/// A dated performance (e.g. a Khasakkinte Ithihasam show) with its own seat capacity.
model ShowSession {
  id               String            @id @default(uuid())
  festivalId       String            @map("festival_id")
  name             String
  venue            String?
  startsAt         DateTime          @map("starts_at")
  totalSeats       Int               @map("total_seats")
  availableSeats   Int               @map("available_seats")
  status           ShowSessionStatus @default(ACTIVE)
  createdAt        DateTime          @default(now()) @map("created_at")
  updatedAt        DateTime          @updatedAt @map("updated_at")

  festival         Festival          @relation(fields: [festivalId], references: [id], onDelete: Cascade)
  attendees        BookingAttendee[]

  @@index([festivalId])
  @@index([startsAt])
  @@map("show_sessions")
}

model Ticket {
  id                 String           @id @default(uuid())
  festivalId         String           @map("festival_id")
  name               String
  description        String?
  ticketType         TicketType       @default(GENERAL) @map("ticket_type")
  price              Decimal          @db.Decimal(12, 2)
  totalQuantity      Int              @map("total_quantity")
  availableQuantity  Int              @map("available_quantity")
  salesStart         DateTime         @map("sales_start")
  salesEnd           DateTime         @map("sales_end")
  status             TicketSaleStatus @default(ACTIVE)
  archivedAt         DateTime?        @map("archived_at")

  /// GST charged on top of `price`, in percent (price is GST-exclusive).
  gstRate            Decimal          @default(18) @db.Decimal(5, 2) @map("gst_rate")
  /// Attendee must pick a single festival day (Day Pass).
  requiresDate       Boolean          @default(false) @map("requires_date")
  /// Attendee must pick a ShowSession (Khasak show, Elite).
  requiresShowSession Boolean         @default(false) @map("requires_show_session")
  /// Age limits (inclusive) checked against attendee date of birth on the festival start date.
  minAge             Int?             @map("min_age")
  maxAge             Int?             @map("max_age")
  /// Valid on every festival day; check-in is recorded once per day (and venue) instead of once.
  multiDay           Boolean          @default(false) @map("multi_day")
  /// Human readable inclusions shown to buyers, e.g. "Front-row seating".
  perks              String[]         @default([])

  createdAt          DateTime         @default(now()) @map("created_at")
  updatedAt          DateTime         @updatedAt @map("updated_at")

  festival           Festival         @relation(fields: [festivalId], references: [id], onDelete: Cascade)
  bookingItems       BookingItem[]
  ticketInstances    TicketInstance[]

  @@index([festivalId])
  @@index([status])
  @@map("tickets")
}

model Customer {
  id         String    @id @default(uuid())
  name       String
  email      String
  phone      String
  createdAt  DateTime  @default(now()) @map("created_at")
  updatedAt  DateTime  @updatedAt @map("updated_at")

  bookings   Booking[]

  @@unique([email])
  @@map("customers")
}

model Booking {
  id             String        @id @default(uuid())
  bookingNumber  String        @unique @map("booking_number")
  festivalId     String        @map("festival_id")
  customerId     String        @map("customer_id")
  status         BookingStatus @default(PENDING_PAYMENT)
  quantity       Int
  /// Sum of item subtotals, before GST.
  subtotalAmount Decimal       @default(0) @db.Decimal(12, 2) @map("subtotal_amount")
  gstAmount      Decimal       @default(0) @db.Decimal(12, 2) @map("gst_amount")
  /// Amount payable: subtotalAmount + gstAmount.
  totalAmount    Decimal       @db.Decimal(12, 2) @map("total_amount")
  currency       String        @default("INR")
  expiresAt      DateTime?     @map("expires_at")
  cancelledAt    DateTime?     @map("cancelled_at")
  cancelReason   String?       @map("cancel_reason")
  createdAt      DateTime      @default(now()) @map("created_at")
  updatedAt      DateTime      @updatedAt @map("updated_at")

  festival       Festival        @relation(fields: [festivalId], references: [id])
  customer       Customer        @relation(fields: [customerId], references: [id])
  bookingItems   BookingItem[]
  payments       Payment[]
  ticketInstances TicketInstance[]

  @@index([festivalId])
  @@index([customerId])
  @@index([status])
  @@index([createdAt])
  @@map("bookings")
}

model BookingItem {
  id          String   @id @default(uuid())
  bookingId   String   @map("booking_id")
  ticketId    String   @map("ticket_id")
  quantity    Int
  unitPrice   Decimal  @db.Decimal(12, 2) @map("unit_price")
  subtotal    Decimal  @db.Decimal(12, 2)
  gstRate     Decimal  @default(0) @db.Decimal(5, 2) @map("gst_rate")
  gstAmount   Decimal  @default(0) @db.Decimal(12, 2) @map("gst_amount")
  createdAt   DateTime @default(now()) @map("created_at")

  booking     Booking  @relation(fields: [bookingId], references: [id], onDelete: Cascade)
  ticket      Ticket   @relation(fields: [ticketId], references: [id])
  ticketInstances TicketInstance[]
  attendees   BookingAttendee[]

  @@index([bookingId])
  @@index([ticketId])
  @@map("booking_items")
}

model Payment {
  id                String              @id @default(uuid())
  bookingId         String              @map("booking_id")
  provider          PaymentProviderType @default(MOCK)
  /// Gateway order id (Razorpay `order_...`); the stable key we look payments up by.
  providerPaymentId String?             @map("provider_payment_id")
  /// Gateway payment id of the captured attempt (Razorpay `pay_...`) - what admins search for in the dashboard.
  gatewayPaymentId  String?             @map("gateway_payment_id")
  refundId          String?             @map("refund_id")
  lastCheckedAt     DateTime?           @map("last_checked_at")
  amount            Decimal             @db.Decimal(12, 2)
  currency          String              @default("INR")
  status            PaymentStatus       @default(PENDING)
  method            String?
  refundedAmount    Decimal             @default(0) @db.Decimal(12, 2) @map("refunded_amount")
  failureReason     String?             @map("failure_reason")
  rawResponse       Json?               @map("raw_response")
  createdAt         DateTime            @default(now()) @map("created_at")
  updatedAt         DateTime            @updatedAt @map("updated_at")

  booking           Booking             @relation(fields: [bookingId], references: [id], onDelete: Cascade)

  @@index([bookingId])
  @@index([status])
  @@map("payments")
}

/// The person who will use one ticket. Captured at booking time (before payment)
/// so a ticket instance can be issued per attendee once the booking is confirmed.
model BookingAttendee {
  id             String       @id @default(uuid())
  bookingItemId  String       @map("booking_item_id")
  name           String
  email          String?
  phone          String?
  dateOfBirth    DateTime?    @map("date_of_birth") @db.Date
  /// The festival day this ticket is valid for (Day Pass).
  validDate      DateTime?    @map("valid_date") @db.Date
  showSessionId  String?      @map("show_session_id")
  createdAt      DateTime     @default(now()) @map("created_at")

  bookingItem    BookingItem  @relation(fields: [bookingItemId], references: [id], onDelete: Cascade)
  showSession    ShowSession? @relation(fields: [showSessionId], references: [id])
  ticketInstance TicketInstance?

  @@index([bookingItemId])
  @@index([showSessionId])
  @@map("booking_attendees")
}

/// One row per (ticket, day, venue) scan, for multi-day passes.
model TicketCheckIn {
  id               String         @id @default(uuid())
  ticketInstanceId String         @map("ticket_instance_id")
  /// Calendar day (IST) the scan counts for.
  checkInDate      DateTime       @map("check_in_date") @db.Date
  /// Empty string when the scan did not name a venue.
  venue            String         @default("")
  checkedInAt      DateTime       @default(now()) @map("checked_in_at")
  checkedInById    String?        @map("checked_in_by_id")

  ticketInstance   TicketInstance @relation(fields: [ticketInstanceId], references: [id], onDelete: Cascade)

  @@unique([ticketInstanceId, checkInDate, venue])
  @@index([checkInDate])
  @@map("ticket_check_ins")
}

model TicketInstance {
  id             String               @id @default(uuid())
  bookingId      String               @map("booking_id")
  bookingItemId  String               @map("booking_item_id")
  ticketId       String               @map("ticket_id")
  attendeeId     String?              @unique @map("attendee_id")
  ticketNumber   String               @unique @map("ticket_number")
  qrCode         String               @map("qr_code")
  status         TicketInstanceStatus @default(VALID)
  checkedInAt    DateTime?            @map("checked_in_at")
  checkedInById  String?              @map("checked_in_by_id")
  createdAt      DateTime             @default(now()) @map("created_at")
  updatedAt      DateTime             @updatedAt @map("updated_at")

  booking        Booking              @relation(fields: [bookingId], references: [id], onDelete: Cascade)
  bookingItem    BookingItem          @relation(fields: [bookingItemId], references: [id], onDelete: Cascade)
  ticket         Ticket               @relation(fields: [ticketId], references: [id])
  checkedInBy    Admin?               @relation("CheckedInBy", fields: [checkedInById], references: [id])
  attendee       BookingAttendee?     @relation(fields: [attendeeId], references: [id])
  checkIns       TicketCheckIn[]

  @@index([bookingId])
  @@index([ticketNumber])
  @@map("ticket_instances")
}

model Sponsor {
  id                 String           @id @default(uuid())
  festivalId         String?          @map("festival_id")
  name               String
  description        String?
  logoUrl            String?          @map("logo_url")
  websiteUrl         String?          @map("website_url")
  contactName        String?          @map("contact_name")
  contactEmail       String?          @map("contact_email")
  contactPhone       String?          @map("contact_phone")
  sponsorshipLevel   SponsorshipLevel @default(PARTNER) @map("sponsorship_level")
  amount             Decimal?         @db.Decimal(12, 2)
  status             SponsorStatus    @default(ACTIVE)
  displayOrder       Int              @default(0) @map("display_order")
  createdAt          DateTime         @default(now()) @map("created_at")
  updatedAt          DateTime         @updatedAt @map("updated_at")

  festival           Festival?        @relation(fields: [festivalId], references: [id], onDelete: SetNull)

  @@index([status])
  @@index([displayOrder])
  @@index([festivalId])
  @@map("sponsors")
}

model AuditLog {
  id          String   @id @default(uuid())
  adminId     String?  @map("admin_id")
  action      String
  entityType  String   @map("entity_type")
  entityId    String?  @map("entity_id")
  oldValue    Json?    @map("old_value")
  newValue    Json?    @map("new_value")
  ipAddress   String?  @map("ip_address")
  createdAt   DateTime @default(now()) @map("created_at")

  admin       Admin?   @relation(fields: [adminId], references: [id], onDelete: SetNull)

  @@index([adminId])
  @@index([entityType, entityId])
  @@index([createdAt])
  @@map("audit_logs")
}

enum EarlyBirdType {
  REGISTER
  VOLUNTEER
  EXHIBIT
  PARTNER
  INFLUENCER
}

model EarlyBirdRegistration {
  id              String   @id @default(uuid())
  name            String
  whatsappNumber  String   @unique @map("whatsapp_number")
  email           String?
  townOrCity      String   @map("town_or_city")
  ageGroup        String   @map("age_group")
  interests       String[]
  interestType    EarlyBirdType @default(REGISTER) @map("interest_type")
  createdAt       DateTime @default(now()) @map("created_at")
  updatedAt       DateTime @updatedAt @map("updated_at")

  @@index([createdAt])
  @@index([interestType])
  @@map("early_bird_registrations")
}

enum EnquiryStatus {
  PENDING
  IN_PROGRESS
  RESOLVED
}

model Enquiry {
  id           String        @id @default(uuid())
  name         String
  email        String
  phone        String
  organisation String
  topic        String?
  notes        String?
  status       EnquiryStatus @default(PENDING)
  createdAt    DateTime      @default(now()) @map("created_at")
  updatedAt    DateTime      @updatedAt @map("updated_at")

  @@index([status])
  @@index([createdAt])
  @@map("enquiries")
}
